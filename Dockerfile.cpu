# Parakeet TDT 0.6B ONNX - CPU Dockerfile
# High-performance speech transcription on CPU

FROM python:3.14-slim

LABEL maintainer="Parakeet TDT"
LABEL description="ONNX-optimized speech transcription service (CPU)"

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

RUN useradd --create-home --shell /bin/bash parakeet
WORKDIR /app

COPY requirements.txt .

# Keep the API/runtime dependency set identical to the GPU image, replacing
# only the execution-provider wheel with the CPU build.
RUN pip install --no-cache-dir --upgrade pip && \
    # silero-vad hard-depends on torch; install the CPU-only build first so
    # pip doesn't pull the multi-GB CUDA torch wheels from PyPI. Both are
    # pinned under silero-vad's torchaudio<2.10 cap, since past it the
    # requirements install downgrades torchaudio and takes the CUDA wheels
    # with it.
    pip install --no-cache-dir torch==2.9.1 torchaudio==2.9.1 --index-url https://download.pytorch.org/whl/cpu && \
    grep -v '^onnxruntime-gpu' requirements.txt > /tmp/requirements.cpu.txt && \
    pip install --no-cache-dir -r /tmp/requirements.cpu.txt && \
    # Must track the onnxruntime-gpu pin in requirements.txt: the CPU and
    # GPU images are expected to run the same ONNX Runtime build.
    pip install --no-cache-dir onnxruntime==1.30.0

# Nothing in the CPU image should install an NVIDIA wheel; ~3.7GB of them
# arrive if the torch pins above ever escape the cap.
RUN if pip list --format=freeze | grep '^nvidia-'; then \
        echo "ERROR: CUDA wheels installed in the CPU image, see the torch pin above" >&2; \
        exit 1; \
    fi

COPY server.py .
COPY parakeet_service/ parakeet_service/

RUN mkdir -p temp_uploads models && \
    chown -R parakeet:parakeet /app

USER parakeet

ENV HF_HOME=/app/models
ENV HF_HUB_CACHE=/app/models
ENV HF_HUB_DISABLE_SYMLINKS_WARNING=true
ENV PYTHONUNBUFFERED=1
ENV PARAKEET_USE_GPU=false
ENV PARAKEET_BATCHED=0

EXPOSE 5092

# start-period covers model load plus the warm-up timeout (120s default):
# the server only answers /healthz once the warm-up chunk has run.
HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:5092/healthz')" || exit 1

CMD ["python", "server.py"]
